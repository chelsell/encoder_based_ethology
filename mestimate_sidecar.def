Bootstrap: docker
From: ubuntu:24.04

%labels
    Author encoder_based_analysis
    Description FFmpeg-libav build/runtime image for mestimate-sidecar
    PipelineScope sidecar-only-not-full-plate-archival-pipeline
    BaseImage ubuntu:24.04
    LibaomVersion 3.13.2
    LibaomCommit ad44980d7f3c7a2605c25d51ea96946949000841
    LibaomSourceTreeSHA256 551238557eccedc2ae987f9dd4660b6351c422e5895c950dfe8b63b5c4b8dfcd

%files
    CMakeLists.txt /opt/mestimate-sidecar/source/CMakeLists.txt
    include /opt/mestimate-sidecar/source/include
    src /opt/mestimate-sidecar/source/src
    tests /opt/mestimate-sidecar/source/tests

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        cmake \
        curl \
        ffmpeg \
        nasm \
        pkg-config \
        python3 \
        python3-numpy \
        rsync \
        zlib1g \
        zlib1g-dev \
        libavformat-dev \
        libavcodec-dev \
        libavfilter-dev \
        libavutil-dev \
        libswscale-dev

    curl -L --fail --retry 3 \
        -o /tmp/libaom-v3.13.2.tar.gz \
        https://aomedia.googlesource.com/aom/+archive/refs/tags/v3.13.2.tar.gz
    mkdir -p /opt/libaom-v3.13.2
    tar -xzf /tmp/libaom-v3.13.2.tar.gz -C /opt/libaom-v3.13.2
    cd /opt/libaom-v3.13.2
    find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum \
        | grep -F "551238557eccedc2ae987f9dd4660b6351c422e5895c950dfe8b63b5c4b8dfcd  -"
    cd /
    cmake -S /opt/libaom-v3.13.2 -B /opt/libaom-v3.13.2/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DENABLE_DOCS=OFF \
        -DENABLE_EXAMPLES=OFF \
        -DENABLE_TESTS=OFF \
        -DENABLE_TOOLS=OFF
    cmake --build /opt/libaom-v3.13.2/build --parallel 1
    cmake --install /opt/libaom-v3.13.2/build
    ldconfig
    test "$(pkg-config --modversion aom)" = "3.13.2"
    ldd /usr/bin/ffmpeg | grep -F /usr/local/lib/libaom.so.3
    rm -rf /opt/libaom-v3.13.2 /tmp/libaom-v3.13.2.tar.gz

    cmake -S /opt/mestimate-sidecar/source -B /opt/mestimate-sidecar/build \
        -DCMAKE_BUILD_TYPE=Release
    cmake --build /opt/mestimate-sidecar/build --parallel 1
    install -Dm755 \
        /opt/mestimate-sidecar/build/mestimate-sidecar \
        /opt/mestimate-sidecar/bin/mestimate-sidecar

    /opt/mestimate-sidecar/bin/mestimate-sidecar --version
    ffmpeg -hide_banner -filters | grep -E '[[:space:]]mestimate[[:space:]]'
    test "$(pkg-config --modversion aom)" = "3.13.2"
    ldd /usr/bin/ffmpeg | grep -F /usr/local/lib/libaom.so.3

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/mestimate-sidecar/bin:$PATH
    export FFMPEG_BIN=/usr/bin/ffmpeg

%runscript
    exec /opt/mestimate-sidecar/bin/mestimate-sidecar "$@"

%test
    set -eux
    /opt/mestimate-sidecar/bin/mestimate-sidecar --version
    ffmpeg -hide_banner -filters | grep -E '[[:space:]]mestimate[[:space:]]'
    cd /opt/mestimate-sidecar/source
    FFMPEG_BIN=/usr/bin/ffmpeg \
        MESTIMATE_SIDECAR_BIN=/opt/mestimate-sidecar/bin/mestimate-sidecar \
        tests/test_synthetic_translation.sh

%help
    This image contains a baked mestimate-sidecar binary linked against the
    image's Ubuntu FFmpeg development libraries. Run it with:

      apptainer run --bind "$PWD":/work mestimate_sidecar.sif \
        --input /work/data/A07.mp4 \
        --output-dir /work/outputs/A07_container \
        --method epzs \
        --mb-size 16 \
        --search-param 12

    The image also includes /usr/bin/ffmpeg for synthetic fixture creation and
    diagnostic codecview overlays.
